      "valueType": "Int",
      "value": "40",
      "required": true,
      "isSensitive": false,
      "supportsOverride": true
    },
    "ConfigCenter.GitSyncTimeoutSeconds": {
      "group": "性能",
      "displayName": "Git 同步超时（秒）",
      "description": "执行元数据 Git 同步时允许的最长等待时间",
      "valueType": "Int",
      "value": "90",
      "required": true,
      "isSensitive": false,
      "supportsOverride": false
    }
