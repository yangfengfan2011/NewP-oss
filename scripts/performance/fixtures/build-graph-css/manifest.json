{
  "index.html": {
    "file": "assets/main.js",
    "isEntry": true,
    "css": ["assets/main.css"],
    "imports": ["_shared.js", "_cycle.js", "_PageOutlet-!~{01p}~.js"],
    "dynamicImports": ["src/module.ts"]
  },
  "secondary.html": { "file": "assets/secondary.js", "imports": ["_shared.js"] },
  "_shared.js": { "file": "assets/shared.js", "imports": ["_cycle.js"] },
  "_cycle.js": { "file": "assets/cycle.js", "imports": ["_shared.js"] },
  "src/module.ts": {
    "file": "assets/module.js",
    "isDynamicEntry": true,
    "css": ["assets/module.css", "assets/main.css", "assets\\standalone.css"],
    "imports": ["_shared.js", "_PageOutlet-!~{01p}~.js", "_shared-style.js"],
    "dynamicImports": ["src/personnel.ts", "src/detail.ts"]
  },
  "src/personnel.ts": {
    "file": "assets/personnel.js",
    "isDynamicEntry": true,
    "imports": ["_shared.js", "_route-style.js"]
  },
  "src/detail.ts": { "file": "assets/detail.js", "imports": ["_shared.js"] },
  "_PageOutlet-!~{01p}~.js": { "file": "assets/standalone.css", "src": "_PageOutlet-!~{01p}~.js" },
  "_shared-style.js": { "file": "assets/standalone.css" },
  "_route-style.js": { "file": "assets/route.css" }
}
