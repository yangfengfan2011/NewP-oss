    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\server\platform-authorization\PlatformAuthorization.csproj" />
    <ProjectReference Include="..\..\server\platform-crud\PlatformCrud.csproj" />
    <ProjectReference Include="..\..\server\kernel\Kernel.csproj" />
    <ProjectReference Include="..\..\server\plugin-contracts\Plugin.Contracts.csproj" />
    <ProjectReference Include="..\..\server\platform-query\PlatformQuery.csproj" />
  </ItemGroup>
