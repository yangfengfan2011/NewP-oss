{
  "schemaVersion": "1.0",
  "type": "view",
  "view": {
    "key": "example.record.list",
    "dicKey": "ExampleRecordListView",
    "titleKey": "Title",
    "descriptionKey": "Description",
    "mode": "list",
    "model": "ExampleRecord",
    "editorMode": "drawer",
    "detailViewKey": "example.record.detail",
    "query": {
      "fields": [
        {
          "key": "keyword",
          "labelKey": "Query_Keyword",
          "source": "preset",
          "preset": "keyword",
          "operator": "like"
        }
      ],
      "defaultSort": {
        "field": "ECODE",
        "direction": "asc"
      },
      "defaultPageSize": 20
    },
    "columns": [
      {
        "key": "code",
        "labelKey": "Column_ECODE",
        "source": "model",
        "field": "ECODE",
        "standardAction": "view",
        "sortable": true,
        "hideable": false,
        "responsivePriority": "high"
      },
      {
        "key": "name",
        "labelKey": "Column_ENAME",
        "source": "model",
        "field": "ENAME",
        "sortable": true,
        "responsivePriority": "high"
      },
      {
        "key": "reviewerUserEid",
        "labelKey": "Column_ReviewerUserEID",
        "source": "model",
        "field": "ReviewerUserEID",
        "responsivePriority": "medium"
      },
      {
        "key": "recordSource",
        "labelKey": "Column_RecordSource",
        "source": "model",
        "field": "RecordSource",
        "responsivePriority": "medium"
      }
    ],
    "pageActions": [
      {
        "key": "create",
        "labelKey": "Action_Create",
        "standardAction": "create",
        "variant": "primary",
        "dataAccess": { "object": "ExampleRecord", "actions": ["create"] }
      }
    ],
    "featureActions": [
      {
        "key": "authorize",
        "titleKey": "对象授权",
        "behaviorKey": "example.record.authorize"
      }
    ],
    "rowActions": [
      {
        "key": "authorize",
        "labelKey": "Action_Authorize",
        "handlerKey": "authorize",
        "inputKey": "objectAuthorization",
          "dataAccess": {"object":"ExampleRecord","actions":["authorize"]},
        "confirmLabelKey": "Action_SaveAuthorization"
      },
      {
        "key": "viewAuthorization",
        "labelKey": "Action_ViewAuthorization",
        "handlerKey": "viewAuthorization",
        "behaviorKey": "example.record.authorize",
        "inputKey": "objectAuthorizationDetails",
          "dataAccess": { "object": "ExampleRecord", "actions": ["read", "authorize"] },
        "confirmLabelKey": "Action_Close"
      },
      {
        "key": "edit",
        "labelKey": "Action_Edit",
        "standardAction": "edit",
        "dataAccess": { "object": "ExampleRecord", "actions": ["edit"] }
      },
      {
        "key": "delete",
        "labelKey": "Action_Delete",
        "standardAction": "delete",
        "variant": "danger",
        "confirmMessageKey": "Action_Delete_Confirm",
        "dataAccess": { "object": "ExampleRecord", "actions": ["delete"] }
      }
    ],
    "export": {
      "dataAccess": {"object":"ExampleRecord","actions":["read"]},
      "modes": [
        "current",
        "all"
      ]
    },
    "resourceKey": "example.record",
    "dataAccess": {
      "execution": "example.record.list",
      "resources": [
        "example.record"
      ]
    }
  }
}
