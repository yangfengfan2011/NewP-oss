{
  "name": "@icp-platform/ui",
  "version": "1.0.0",
  "description": "ICP Platform shared UI component library",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./button": {
      "types": "./dist/components/Button.d.ts",
      "import": "./dist/components/Button.js"
    },
    "./crud": {
      "types": "./dist/crud.d.ts",
      "import": "./dist/crud.js"
    },
    "./crud-detail": {
      "types": "./dist/crud-detail.d.ts",
      "import": "./dist/crud-detail.js"
    },
    "./crud-form": {
      "types": "./dist/crud-form.d.ts",
      "import": "./dist/crud-form.js"
    },
    "./crud-list": {
      "types": "./dist/crud-list.d.ts",
      "import": "./dist/crud-list.js"
    },
    "./styles": "./src/styles/index.css"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "@ant-design/pro-components": "^2.8.10",
    "@ant-design/pro-descriptions": "^2.6.10",
    "@icp-platform/sdk": "workspace:*",
    "@icp-platform/core": "workspace:*",
    "antd": "^5.29.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0"
  }
}
