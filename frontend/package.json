{
  "name": "@icp-platform/frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "error"
    }
  },
  "workspaces": [
    "packages/*",
    "modules/**",
    "templates/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @icp-platform/shell dev",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" \"modules/**/*.{ts,tsx}\" \"templates/**/*.{ts,tsx}\" --report-unused-disable-directives --max-warnings 0",
    "test": "pnpm run test:effect-network-lifecycle && pnpm run test:component-frontend-build && pnpm run check:effect-network-lifecycle && pnpm -r --if-present test",
    "test:component-frontend-build": "node --test scripts/ui-source-aliases.test.mjs",
    "test:effect-network-lifecycle": "node --test scripts/check-effect-network-lifecycle.test.mjs",
    "check:effect-network-lifecycle": "node scripts/check-effect-network-lifecycle.mjs",
    "build": "pnpm -r build",
    "clean": "pnpm -r exec rimraf dist node_modules .vite"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.4.2"
  }
}
