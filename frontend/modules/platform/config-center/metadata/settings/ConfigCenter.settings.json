{
  "schemaVersion": "1.0",
  "type": "settings",
  "settings": {
    "ConfigCenter.AuditRetentionDays": {
      "group": "性能",
      "displayName": "配置审计保留天数",
      "description": "配置变更审计记录的默认保留周期",
