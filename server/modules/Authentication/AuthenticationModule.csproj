<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ICP.Platform.Modules.Authentication</RootNamespace>
    <AssemblyName>AuthenticationModule</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Contracts\Authentication.Contracts.csproj" />
    <ProjectReference Include="..\..\sdk\Sdk.csproj" />
    <ProjectReference Include="..\..\platform-modeling\PlatformModeling.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Contracts\**\*.cs" />
    <EmbeddedResource Include="..\..\..\modules\Authentication\newp.plugin.json">
      <LogicalName>ICP.Platform.Modules.Authentication.newp.plugin.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
