<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ICP.Platform.Modules.Example</RootNamespace>
    <AssemblyName>ExampleModule</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\Sdk.csproj" />
    <ProjectReference Include="..\..\platform-authorization\PlatformAuthorization.csproj" />
    <ProjectReference Include="..\..\platform-crud\PlatformCrud.csproj" />
    <ProjectReference Include="..\..\platform-modeling\PlatformModeling.csproj" />
    <ProjectReference Include="..\Identity\Contracts\Identity.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Migrations.SqlServer\**\*.cs" />
    <EmbeddedResource Include="..\..\..\frontend\modules\example\newp.plugin.json">
      <LogicalName>ICP.Platform.Modules.Example.newp.plugin.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
