{
  "name": "@icp-platform/frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "error"
    }
  },
  "workspaces": [
    "packages/*",
    "modules/*",
    "templates/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @icp-platform/shell dev",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r build",
    "clean": "pnpm -r exec rimraf dist node_modules .vite"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.4.2"
  }
}
