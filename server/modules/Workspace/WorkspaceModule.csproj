<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WorkspaceModule</AssemblyName>
    <RootNamespace>ICP.Platform.Modules.Workspace</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../sdk/Sdk.csproj" />
    <ProjectReference Include="../../platform-authorization/PlatformAuthorization.csproj" />
    <ProjectReference Include="../../platform-modeling/PlatformModeling.csproj" />
    <ProjectReference Include="../../platform-crud/PlatformCrud.csproj" />
    <ProjectReference Include="../../platform-persistence-efcore/PlatformPersistence.EfCore.csproj" />
    <ProjectReference Include="../Authorization/Contracts/Authorization.Contracts.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Migrations.SqlServer/**/*.cs" />
    <EmbeddedResource Include="../../../frontend/modules/workspace/newp.plugin.json" LogicalName="ICP.Platform.Modules.Workspace.newp.plugin.json" />
  </ItemGroup>
</Project>
