{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=NewP;Integrated Security=True;TrustServerCertificate=True",
    "Oracle": "Data Source=localhost:1521/FREEPDB1;User Id=newp;Password=",
    "MySql": "Server=localhost;Port=3306;Database=NewP;User ID=newp;Password="
  },
  "Persistence": {
    "Adapter": "EfCore",
    "Provider": "SqlServer",
    "AutoSeed": true
  },
  "Platform": {
    "ModulesPath": "./modules",
    "HostVersion": "1.1.0",
    "EnableSwagger": true,
    "ExternalPluginsEnabled": false,
    "DisabledPlugins": []
  },
  "Identity": {
    "LocalAdministrator": {
      "ECODE": "admin",
      "ENAME": "Local Administrator"
    }
  },
  "Authentication": {
    "Sessions": {
      "Lifetime": "08:00:00",
      "PurgeBatchSize": 500,
      "DefaultTimeZoneId": "Asia/Shanghai"
    },
    "Host": {
      "CookieName": "__Host-ICP.Platform.Auth",
      "ApplicationName": "ICP.Platform.HostApi.Authentication.v1",
      "ProtectKeysAtRest": true,
      "LoginAttemptsPerMinute": 10,
      "MaximumConcurrentPasswordVerifications": 20,
      "TrustedProxies": [],
      "TrustedNetworks": []
    }
  }
}
