<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ICP.Platform.PluginTool</RootNamespace>
    <AssemblyName>ICP.Platform.Plugin.Tool</AssemblyName>
    <PackageId>ICP.Platform.Plugin.Tool</PackageId>
    <Version>1.0.0</Version>
    <Description>NewP standard-data plugin validate, explain, pack and verify tool.</Description>
    <Authors>ICP Platform Team</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>newp</ToolCommandName>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\server\plugin-contracts\Plugin.Contracts.csproj" />
    <ProjectReference Include="..\..\server\plugin-sdk\Plugin.Sdk.csproj" />
    <ProjectReference Include="..\..\server\platform-persistence\PlatformPersistence.csproj" />
    <None Include="..\..\server\platform-modeling\metadata\storage-types.json" Link="storage-types.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\server\plugin-contracts\platform-api-release.identity.json"
          Link="platform-api-release.identity.json"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="contentFiles/any/any" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
