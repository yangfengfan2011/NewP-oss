{
  "schemaVersion": "1.0",
  "moduleId": "Example",
  "displayName": "功能示例",
  "version": "1.0.0",
  "description": "功能示例 模块",
  "entryAssembly": "../../ExampleModule.dll",
  "dependencies": [
    "Identity"
  ],
  "hostVersion": {
    "min": "1.0.0",
    "max": "2.0.0"
  },
  "backend": {
    "behaviorKey": "example.backend"
  },
  "frontend": {
    "behaviorKey": "example.frontend",
    "entry": "example",
    "bindingMode": "behavior-bindings",
    "bindings": [
      "example.runtime-workload.list",
      "example.record.list",
      "example.record.detail"
    ]
  },
  "security": {
    "permissions": [
      {
        "code": "Example.View",
        "displayName": "查看功能示例",
        "description": "允许访问功能示例页面",
        "group": "功能示例"
      },
      {
        "code": "Example.Record.View",
        "displayName": "查看示例记录",
        "description": "允许查看持久化示例记录",
        "group": "功能示例"
      },
      {
        "code": "Example.Record.Create",
        "displayName": "新建示例记录",
        "description": "允许新建持久化示例记录",
        "group": "功能示例"
      },
      {
        "code": "Example.Record.Update",
        "displayName": "更新示例记录",
        "description": "允许更新持久化示例记录",
        "group": "功能示例"
      },
      {
        "code": "Example.Record.Delete",
        "displayName": "删除示例记录",
        "description": "允许删除持久化示例记录",
        "group": "功能示例"
      }
    ]
  },
  "persistence": {
    "models": [
      "metadata/models/ExampleRecord.model.json"
    ],
    "migrations": {
      "sqlServer": {
        "assembly": "migrations/Example.SqlServerMigrations.dll",
        "manifest": "migrations/Example.SqlServerMigrations.json"
      }
    }
  }
}
