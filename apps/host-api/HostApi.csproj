<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ICP.Platform.HostApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="modules\**\plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\modules\Organization\newp.plugin.json">
      <Link>modules\Organization\plugin.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\modules\Identity\newp.plugin.json">
      <Link>modules\Identity\plugin.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\modules\Authentication\newp.plugin.json">
      <Link>modules\Authentication\plugin.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\modules\Identity\migrations\Identity.SqlServerMigrations.json">
      <Link>modules\Identity\migrations\Identity.SqlServerMigrations.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\modules\Organization\migrations\Organization.SqlServerMigrations.json">
      <Link>modules\Organization\migrations\Organization.SqlServerMigrations.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\modules\Authentication\migrations\Authentication.SqlServerMigrations.json">
      <Link>modules\Authentication\migrations\Authentication.SqlServerMigrations.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\modules\Example\migrations\Example.SqlServerMigrations.json">
      <Link>modules\Example\migrations\Example.SqlServerMigrations.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\server\modules\Identity\Migrations.SqlServer\bin\$(Configuration)\$(TargetFramework)\Identity.SqlServerMigrations.dll">
      <Link>modules\Identity\migrations\Identity.SqlServerMigrations.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\server\modules\Organization\Migrations.SqlServer\bin\$(Configuration)\$(TargetFramework)\Organization.SqlServerMigrations.dll">
      <Link>modules\Organization\migrations\Organization.SqlServerMigrations.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\server\modules\Authentication\Migrations.SqlServer\bin\$(Configuration)\$(TargetFramework)\Authentication.SqlServerMigrations.dll">
      <Link>modules\Authentication\migrations\Authentication.SqlServerMigrations.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\server\modules\Example\Migrations.SqlServer\bin\$(Configuration)\$(TargetFramework)\Example.SqlServerMigrations.dll">
      <Link>modules\Example\migrations\Example.SqlServerMigrations.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\modules\**\metadata\**\*.json">
      <Link>modules\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\server\platform-modeling\metadata\storage-types.json">
      <Link>server\platform-modeling\metadata\storage-types.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Development-time staging only; runtime module composition is manifest-driven. -->
    <ProjectReference Include="..\..\server\kernel\Kernel.csproj" />
    <ProjectReference Include="..\..\server\sdk\Sdk.csproj" />
    <ProjectReference Include="..\..\server\platform-authorization\PlatformAuthorization.csproj" />
    <ProjectReference Include="..\..\server\platform-crud\PlatformCrud.csproj" />
    <ProjectReference Include="..\..\server\platform-modeling\PlatformModeling.csproj" />
    <ProjectReference Include="..\..\server\platform-presentation\PlatformPresentation.csproj" />
    <ProjectReference Include="..\..\server\platform-persistence-composition\PlatformPersistence.Composition.csproj" />
    <ProjectReference Include="..\..\server\platform-persistence-efcore.migrations.sqlserver\PlatformPersistence.EfCore.SqlServerMigrations.csproj" />
    <ProjectReference Include="..\..\server\platform-persistence-efcore.migrations.oracle\PlatformPersistence.EfCore.OracleMigrations.csproj" />
    <ProjectReference Include="..\..\server\platform-persistence-efcore.migrations.mysql\PlatformPersistence.EfCore.MySqlMigrations.csproj" />
    <ProjectReference Include="..\..\server\plugin-platform\PluginPlatform.csproj" />
    <ProjectReference Include="..\..\server\modules\Demo\DemoModule.csproj" />
    <ProjectReference Include="..\..\server\modules\Authorization\AuthorizationModule.csproj" />
    <ProjectReference Include="..\..\server\modules\ConfigCenter\ConfigCenter.csproj" />
    <ProjectReference Include="..\..\server\modules\MetadataConfigCenter\MetadataConfigCenter.csproj" />
    <ProjectReference Include="..\..\server\modules\Audit\AuditModule.csproj" />
    <ProjectReference Include="..\..\server\modules\Files\FilesModule.csproj" />
    <ProjectReference Include="..\..\server\modules\ModuleTemplateSample\ModuleTemplateSample.csproj" />
    <ProjectReference Include="..\..\server\modules\Organization\OrganizationModule.csproj" />
    <ProjectReference Include="..\..\server\modules\Identity\IdentityModule.csproj" />
    <ProjectReference Include="..\..\server\modules\Authentication\AuthenticationModule.csproj" />
    <ProjectReference Include="..\..\server\modules\Identity\Migrations.SqlServer\Identity.SqlServerMigrations.csproj" />
    <ProjectReference Include="..\..\server\modules\Organization\Migrations.SqlServer\Organization.SqlServerMigrations.csproj" />
    <ProjectReference Include="..\..\server\modules\Authentication\Migrations.SqlServer\Authentication.SqlServerMigrations.csproj" />
    <ProjectReference Include="..\..\server\modules\Example\Migrations.SqlServer\Example.SqlServerMigrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\server\modules\Example\Example.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\modules\Example\newp.plugin.json">
      <Link>modules\Example\plugin.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
