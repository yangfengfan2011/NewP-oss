{
  "schemaVersion": "1.0",
  "moduleId": "Identity",
  "displayName": "身份基础",
  "version": "1.0.0",
  "description": "平台用户账号与本地凭据基础模块",
  "entryAssembly": "../../IdentityModule.dll",
  "dependencies": [],
  "hostVersion": {
    "min": "1.0.0",
    "max": "2.0.0"
  },
  "backend": {
    "behaviorKey": "identity.backend"
  },
  "frontend": {
    "behaviorKey": "identity.frontend",
    "entry": "identity",
    "bindingMode": "behavior-bindings",
    "bindings": [
      "identity.account.list",
      "identity.account.detail"
    ]
  },
  "security": {
    "permissions": []
  },
  "persistence": {
    "models": [
      "metadata/models/IdentityAccount.model.json",
      "metadata/models/LocalCredential.model.json",
      "metadata/models/IdentitySecurityEvent.model.json"
    ],
    "migrations": {
      "sqlServer": {
        "assembly": "migrations/Identity.SqlServerMigrations.dll",
        "manifest": "migrations/Identity.SqlServerMigrations.json"
      }
    }
  }
}
