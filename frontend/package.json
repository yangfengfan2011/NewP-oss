{
  "name": "@icp-platform/frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "error"
    }
  },
  "workspaces": [
    "packages/*",
    "modules/*",
    "templates/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @icp-platform/shell dev",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" \"modules/**/*.{ts,tsx}\" \"templates/**/*.{ts,tsx}\" --report-unused-disable-directives --max-warnings 0",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r build",
    "clean": "pnpm -r exec rimraf dist node_modules .vite"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.4.2"
  }
}
