{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=ICP_Platform;Trusted_Connection=True;TrustServerCertificate=True;",
    "Oracle": "User Id=icp;Password=REDACTED_FOR_OPEN_SOURCE;Data Source=localhost/FREEPDB1;",
    "MySql": "Server=localhost;Database=icp_platform;User=root;Password=REDACTED_FOR_OPEN_SOURCE;"
  },
  "Persistence": {
    "Adapter": "EfCore",
    "Provider": "SqlServer",
    "AutoMigrate": true,
    "AutoSeed": true
  },
  "Platform": {
    "ModulesPath": "./modules",
    "HostVersion": "1.0.0",
    "EnableSwagger": true,
    "ExternalPluginsEnabled": false,
    "DisabledPlugins": []
  },
  "Identity": {
    "LocalAdministrator": {
      "ECODE": "admin",
      "ENAME": "Local Administrator"
    }
  },
  "Authentication": {
    "Sessions": {
      "Lifetime": "08:00:00",
      "PurgeBatchSize": 500
    },
    "Host": {
      "CookieName": "__Host-ICP.Platform.Auth",
      "ApplicationName": "ICP.Platform.HostApi.Authentication.v1",
      "ProtectKeysAtRest": true,
      "LoginAttemptsPerMinute": 10,
      "MaximumConcurrentPasswordVerifications": 20,
      "TrustedProxies": [],
      "TrustedNetworks": []
    }
  }
}
