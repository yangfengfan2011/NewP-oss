<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Part.SqlServerMigrations</AssemblyName>
    <RootNamespace>ICP.Platform.Modules.Part.Migrations.SqlServer</RootNamespace>
    <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols><Optimize>true</Optimize><Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/Part.SqlServerMigrations</PathMap>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PartModule.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>
</Project>
