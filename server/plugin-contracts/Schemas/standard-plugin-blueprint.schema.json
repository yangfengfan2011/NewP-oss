{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newp.local/schemas/standard-plugin-blueprint.v1.schema.json",
  "title": "NewP Standard Plugin Blueprint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "moduleId",
    "displayName",
    "version",
    "compatibility",
    "standardData",
    "navigation",
    "persistence"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "profile": { "const": "standard-data.v1" },
    "moduleId": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)+$"
    },
    "displayName": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": { "type": "string" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformApi", "persistence"],
      "properties": {
        "platformApi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minInclusive", "maxExclusive"],
          "properties": {
            "minInclusive": { "type": "string" },
            "maxExclusive": { "type": "string" }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract", "providers"],
          "properties": {
            "contract": { "const": "ef-migrations.v1" },
            "providers": {
              "type": "array",
              "prefixItems": [{ "const": "sqlServer" }],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            }
          }
        }
      }
    },
    "standardData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resources"],
      "properties": {
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "group", "menu", "order"],
      "properties": {
        "slot": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "minLength": 1 },
        "menu": { "type": "string", "minLength": 1 },
        "order": { "type": "integer" }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models", "migrations"],
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/packagePath" }
        },
        "migrations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sqlServer"],
          "properties": {
            "sqlServer": {
              "type": "object",
              "additionalProperties": false,
              "required": ["assembly", "manifest"],
              "properties": {
                "assembly": { "$ref": "#/$defs/packagePath" },
                "manifest": { "$ref": "#/$defs/packagePath" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "pluralName", "displayName", "displayField", "fields"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "pluralName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "displayField": { "type": "string", "minLength": 1 },
        "detailViewKey": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "required"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
              "type": {
                "enum": ["string", "date", "dateTime", "boolean", "integer", "decimal"]
              },
              "required": { "type": "boolean" },
              "unique": { "type": "boolean", "default": false }
            }
          }
        }
      }
    }
  }
}
